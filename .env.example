# Copier ce fichier en .env (ne jamais committer .env).
# Précédence : variable d'environnement > .env > valeur par défaut.

# Répertoire de données (défaut : ~/.clubmanager)
CLUBMANAGER_DATA_DIR=~/.clubmanager
# Répertoire des logs (défaut : <CLUBMANAGER_DATA_DIR>/logs)
# CLUBMANAGER_LOG_DIR=~/.clubmanager/logs
# Niveau de log : DEBUG, INFO, WARNING, ERROR (défaut : INFO)
CLUBMANAGER_LOG_LEVEL=INFO
# Base par défaut quand aucune n'est sélectionnée (défaut : club_manager.db)
CLUBMANAGER_DB_PATH=club_manager.db
# Clé de chiffrement du mot de passe SMTP (non définie par défaut => clé par défaut NON sécurisée).
# À définir en production, avant d'enregistrer la config SMTP. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SECRET_KEY=<définir une valeur longue et aléatoire>
