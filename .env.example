# Répertoire de données (défaut : ~/.clubmanager)
CLUBMANAGER_DATA_DIR=~/.clubmanager
# Répertoire des logs (défaut : <data_dir>/logs)
# CLUBMANAGER_LOG_DIR=~/.clubmanager/logs
# Niveau de log : DEBUG, INFO, WARNING, ERROR
CLUBMANAGER_LOG_LEVEL=INFO
# Base par défaut quand aucune n'est sélectionnée
CLUBMANAGER_DB_PATH=club_manager.db
# Clé de chiffrement du mot de passe SMTP (À CHANGER en production)
# APP_SECRET_KEY=<définir une valeur longue et aléatoire>
